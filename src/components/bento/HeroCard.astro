---
import { profileConfig } from '@/config/profile';
import { ArrowUpRight, Mail } from '@lucide/astro';
---

<div class="bento-card p-6 sm:p-8 flex flex-col justify-between">
  <div>
    <!-- Avatar & Status -->
    <div class="flex items-center justify-between gap-4 mb-6">
      <div class="relative">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border border-neutral-200/80 dark:border-neutral-800 shadow-sm">
          <img
            src={profileConfig.personal.avatarUrl}
            alt={profileConfig.personal.name}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900 shadow-xs"></div>
      </div>

      {profileConfig.personal.availableForWork && (
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
          <span>{profileConfig.personal.statusText}</span>
        </div>
      )}
    </div>

    <!-- Identity & Title -->
    <div class="mb-4">
      <div class="flex items-baseline gap-2 mb-1">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white">
          {profileConfig.personal.name}
        </h1>
        <span class="text-sm font-medium text-neutral-400 dark:text-neutral-500">
          ({profileConfig.personal.nativeName})
        </span>
      </div>
      <p class="text-xs sm:text-sm font-medium tracking-wide text-neutral-500 dark:text-neutral-400 uppercase">
        {profileConfig.personal.title}
      </p>
    </div>

    <!-- Headline & Bio -->
    <p class="text-base sm:text-lg font-medium text-neutral-800 dark:text-neutral-200 leading-snug mb-3">
      {profileConfig.personal.headline}
    </p>

    <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
      {profileConfig.personal.shortBio}
    </p>
  </div>

  <!-- Bottom Action Buttons -->
  <div class="pt-6 mt-6 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center gap-3">
    <a
      href="#featured-projects"
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs sm:text-sm font-medium hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all group"
    >
      <span>查看精选作品</span>
      <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </a>

    <a
      href="mailto:contact@tschenfeng.com"
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/60 text-neutral-700 dark:text-neutral-300 text-xs sm:text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all"
    >
      <Mail class="w-3.5 h-3.5" />
      <span>联系沟通</span>
    </a>
  </div>
</div>
