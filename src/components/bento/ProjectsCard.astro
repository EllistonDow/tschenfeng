---
import { getCollection } from 'astro:content';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { ArrowUpRight, ExternalLink } from '@lucide/astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
---

<div class="bento-card p-6 sm:p-8 flex flex-col justify-between" id="featured-projects">
  <div>
    <!-- Section Header -->
    <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-neutral-800/80 mb-5">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        精选代表作 / Featured Projects
      </div>
      <a
        href="/projects"
        class="inline-flex items-center gap-1 text-xs text-neutral-600 dark:text-neutral-400 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition-colors"
      >
        <span>全部作品</span>
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- Project Items -->
    <div class="space-y-3.5">
      {featuredProjects.map((project) => (
        <div class="p-4 rounded-xl border border-neutral-200/50 dark:border-neutral-800/60 bg-neutral-50/30 dark:bg-neutral-900/30 hover:bg-neutral-50/80 dark:hover:bg-neutral-800/60 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all group">
          <div class="flex items-start justify-between gap-3 mb-1">
            <h3 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {project.data.title}
            </h3>

            <div class="flex items-center gap-2 shrink-0">
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1 text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
                  title="GitHub 源码"
                >
                  <SocialIcon name="github" class="w-3.5 h-3.5" />
                </a>
              )}
              {project.data.link && (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1 text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
                  title="在线预览"
                >
                  <ExternalLink class="w-3.5 h-3.5" />
                </a>
              )}
            </div>
          </div>

          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-3 line-clamp-2">
            {project.data.description}
          </p>

          <div class="flex items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-1.5">
              {project.data.tags.slice(0, 3).map((tag) => (
                <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>

            {project.data.metrics && (
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">
                {project.data.metrics}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="pt-4 mt-5 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500">
    <span>以生产级标准打造高可用工具与应用</span>
    <span class="font-mono">Open Source</span>
  </div>
</div>
