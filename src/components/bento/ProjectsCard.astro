---
import { getCollection } from 'astro:content';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { Layers, ArrowUpRight, ExternalLink } from '@lucide/astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
---

<div class="bento-card lg:col-span-2 lg:row-span-2 p-6 sm:p-7 flex flex-col justify-between" id="featured-projects">
  <div>
    <!-- Card Header -->
    <div class="flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 mb-5">
      <span class="font-medium tracking-wide uppercase flex items-center gap-1.5">
        <Layers class="w-3.5 h-3.5 text-indigo-500" />
        <span>精选代表作与工程项目</span>
      </span>
      <a
        href="/projects"
        class="inline-flex items-center gap-1 text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-medium"
      >
        <span>全部作品</span>
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- Project List -->
    <div class="space-y-4">
      {featuredProjects.map((project) => (
        <div class="p-4 rounded-xl border border-neutral-200/70 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/50 hover:bg-white dark:hover:bg-neutral-800/80 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all group">
          <div class="flex items-start justify-between gap-3 mb-1.5">
            <h3 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {project.data.title}
            </h3>

            <!-- Action Links -->
            <div class="flex items-center gap-2 shrink-0">
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1 text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
                  title="查看源码"
                >
                  <SocialIcon name="github" class="w-3.5 h-3.5" />
                </a>
              )}
              {project.data.link && (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1 text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
                  title="访问在线演示"
                >
                  <ExternalLink class="w-3.5 h-3.5" />
                </a>
              )}
            </div>
          </div>

          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-3 line-clamp-2 leading-relaxed">
            {project.data.description}
          </p>

          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-1.5">
              {project.data.tags.slice(0, 3).map((tag) => (
                <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-neutral-200/60 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                  {tag}
                </span>
              ))}
            </div>

            {project.data.metrics && (
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">
                {project.data.metrics}
              </span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800/80 mt-4 flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
    <span>专注于解决真实场景下的工程瓶颈</span>
    <a
      href="/projects"
      class="font-medium text-neutral-800 dark:text-neutral-200 hover:text-indigo-600 dark:hover:text-indigo-400 inline-flex items-center gap-1 transition-colors"
    >
      <span>浏览完整作品集</span>
      <ArrowUpRight class="w-3 h-3" />
    </a>
  </div>
</div>
