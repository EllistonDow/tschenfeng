---
import HeroCard from './HeroCard.astro';
import ConnectCard from './ConnectCard.astro';
import ProjectsCard from './ProjectsCard.astro';
import BlogPreviewCard from './BlogPreviewCard.astro';
---

<div class="w-full">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
    <!-- Row 1: Identity & Bio (Left) | Presence & Connect (Right) -->
    <HeroCard />
    <ConnectCard />

    <!-- Row 2: Featured Projects (Left) | Recent Writing & Thoughts (Right) -->
    <ProjectsCard />
    <BlogPreviewCard />
  </div>
</div>
