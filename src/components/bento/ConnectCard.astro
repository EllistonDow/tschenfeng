---
import { profileConfig } from '@/config/profile';
import LiveClock from '@/components/ui/LiveClock.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { MapPin, ArrowUpRight } from '@lucide/astro';

const highlightedTech = profileConfig.techStack.filter(t => t.highlight);
---

<div class="bento-card p-6 sm:p-8 flex flex-col justify-between">
  <!-- Top: Location & Live Time -->
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-neutral-800/80">
      <div class="flex items-center gap-2 text-xs font-medium text-neutral-500 dark:text-neutral-400">
        <MapPin class="w-3.5 h-3.5 text-indigo-500" />
        <span class="text-neutral-800 dark:text-neutral-200 font-semibold">{profileConfig.personal.location}</span>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
        <LiveClock timezone={profileConfig.personal.timezone} />
      </div>
    </div>

    <!-- Middle: Social Links Grid (Spacious & Clean) -->
    <div class="py-5">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-3">
        社交与主页 / Connect
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        {profileConfig.socials.slice(0, 4).map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-neutral-200/50 dark:border-neutral-800/60 bg-neutral-50/40 dark:bg-neutral-900/40 hover:bg-white dark:hover:bg-neutral-800/80 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <SocialIcon
                name={social.icon}
                class="w-4 h-4 text-neutral-500 dark:text-neutral-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors shrink-0"
              />
              <span class="text-xs font-medium text-neutral-700 dark:text-neutral-200 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors truncate">
                {social.name}
              </span>
            </div>
            <ArrowUpRight class="w-3.5 h-3.5 text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom: Core Tech Stack -->
  <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800/80">
    <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2.5">
      核心技术栈 / Core Stack
    </div>
    <div class="flex flex-wrap gap-1.5">
      {highlightedTech.map((tech) => (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-100/70 dark:bg-neutral-800/70 text-neutral-700 dark:text-neutral-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500/70"></span>
          <span>{tech.name}</span>
        </span>
      ))}
    </div>
  </div>
</div>
