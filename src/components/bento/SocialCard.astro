---
import { profileConfig } from '@/config/profile';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<div class="bento-card lg:col-span-1 lg:row-span-1 p-5 sm:p-6 flex flex-col justify-between">
  <div class="flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 mb-2">
    <span class="font-medium tracking-wide uppercase">社交与主页</span>
    <span class="text-[11px] text-neutral-400">Connect</span>
  </div>

  <div class="grid grid-cols-2 gap-2 my-auto">
    {profileConfig.socials.slice(0, 4).map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        title={social.label}
        class="group flex items-center justify-between px-2 py-2 sm:px-2.5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/90 bg-neutral-50/60 dark:bg-neutral-900/60 hover:bg-white dark:hover:bg-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all"
      >
        <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
          <SocialIcon
            name={social.icon}
            class="w-3.5 h-3.5 text-neutral-600 dark:text-neutral-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors shrink-0"
          />
          <span class="text-[11px] sm:text-xs font-medium text-neutral-800 dark:text-neutral-200 truncate">
            {social.name}
          </span>
        </div>
        <ArrowUpRight class="w-3 h-3 text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0" />
      </a>
    ))}
  </div>

  <div class="pt-2 text-[11px] text-neutral-400 dark:text-neutral-500 truncate">
    <span>欢迎交流与探讨技术</span>
  </div>
</div>
