---
import { getProfileConfig } from '@/config/profile';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import LiveClock from '@/components/ui/LiveClock.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { MapPin, X, ChevronRight, Mail, ArrowUpRight } from '@lucide/astro';

interface Props {
  lang?: Lang;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const profile = getProfileConfig(lang);

const highlightedTech = profile.techStack.filter((t) => t.highlight);
---

<div id="magnetic-profile-root">
  <!-- 1. Desktop Left-Anchored Sticky Magnetic Avatar (Positioned outside the stream's left edge, NEVER overlaps content) -->
  <div class="hidden lg:block absolute -left-16 xl:-left-20 top-2 z-30 pointer-events-auto">
    <div class="sticky top-28">
      <button
        id="profile-trigger-desktop"
        type="button"
        aria-expanded="false"
        aria-controls="profile-card"
        aria-label={`${t('profile.viewProfile')} - ${profile.personal.name}`}
        title={`${t('profile.viewProfile')} - ${profile.personal.name}`}
        class="profile-open-btn group relative p-1 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-lg hover:shadow-2xl hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300 hover:scale-110 cursor-pointer"
      >
        <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl overflow-hidden shadow-xs">
          <img
            src={profile.personal.avatarUrl}
            alt={profile.personal.name}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="eager"
          />
        </div>
        <!-- Active Status Pulse Dot -->
        <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900 shadow-xs flex items-center justify-center">
          <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-neutral-900 animate-pulse-subtle"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- 2. Mobile/Tablet Inline Header Card (Cleanly placed at top of stream, NEVER overlaps scrolling text) -->
  <div class="lg:hidden mb-6">
    <button
      id="profile-trigger-mobile"
      type="button"
      aria-expanded="false"
      aria-controls="profile-card"
      class="profile-open-btn w-full p-3.5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md shadow-sm hover:shadow-md hover:border-neutral-300 dark:hover:border-neutral-700 transition-all flex items-center justify-between gap-3 text-left cursor-pointer group"
    >
      <div class="flex items-center gap-3 min-w-0">
        <div class="relative shrink-0 w-10 h-10 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-700 shadow-xs">
          <img
            src={profile.personal.avatarUrl}
            alt={profile.personal.name}
            class="w-full h-full object-cover"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900"></span>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-neutral-900 dark:text-white truncate">
              {profile.personal.name}
            </span>
            <span class="text-[10px] font-medium px-1.5 py-0.2 rounded-md bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60 shrink-0">
              {t('profile.status')}
            </span>
          </div>
          <p class="text-[11px] text-neutral-500 dark:text-neutral-400 truncate">
            {profile.personal.title}
          </p>
        </div>
      </div>

      <div class="shrink-0 flex items-center gap-1 text-xs text-indigo-600 dark:text-indigo-400 font-medium">
        <span>{lang === 'zh' ? '档案' : 'Bio'}</span>
        <ChevronRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
      </div>
    </button>
  </div>

  <!-- 3. Overlay Backdrop for Click-Outside (Mobile & Desktop) -->
  <div
    id="profile-backdrop"
    class="fixed inset-0 bg-neutral-950/40 dark:bg-black/60 backdrop-blur-xs z-[9998] opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- 4. Expanded Profile Card Panel -->
  <div
    id="profile-card"
    class="fixed bottom-4 left-4 right-4 sm:right-auto sm:left-1/2 sm:-translate-x-1/2 lg:translate-x-0 sm:w-[390px] max-h-[88vh] overflow-y-auto rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xl p-6 pb-8 lg:bottom-auto lg:top-24 lg:left-[max(1.5rem,calc(50vw-24rem-12rem))] z-[9999] opacity-0 pointer-events-none scale-95 transition-all duration-300 ease-out"
  >
    <!-- Header: Status & Close Button -->
    <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-neutral-800/80 mb-5">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
        <span>{profile.personal.statusText}</span>
      </div>

      <button
        id="profile-close"
        type="button"
        aria-label={t('profile.close')}
        class="w-7 h-7 rounded-full flex items-center justify-center text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Avatar & Identity -->
    <div class="flex items-center gap-4 mb-4">
      <div class="relative shrink-0">
        <div class="w-16 h-16 rounded-2xl overflow-hidden border border-neutral-200 dark:border-neutral-700 shadow-sm">
          <img
            src={profile.personal.avatarUrl}
            alt={profile.personal.name}
            class="w-full h-full object-cover"
          />
        </div>
        <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900"></span>
      </div>

      <div>
        <h2 class="text-xl font-bold text-neutral-900 dark:text-white mb-0.5">
          {profile.personal.name}
        </h2>
        <p class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
          {profile.personal.title}
        </p>
      </div>
    </div>

    <!-- Bio Statement -->
    <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
      {profile.personal.shortBio}
    </p>

    <!-- Location & Live Clock -->
    <div class="p-3.5 rounded-2xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200/60 dark:border-neutral-700/60 mb-5">
      <div class="flex items-center justify-between text-xs mb-2">
        <div class="flex items-center gap-1.5 text-neutral-600 dark:text-neutral-400 font-medium">
          <MapPin class="w-3.5 h-3.5 text-indigo-500" />
          <span>{profile.personal.location}</span>
        </div>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">{profile.personal.timezone}</span>
      </div>
      <div class="flex items-center justify-between text-xs">
        <span class="text-neutral-400 dark:text-neutral-500">{t('profile.localTime')}</span>
        <div class="font-mono font-semibold text-neutral-800 dark:text-neutral-200">
          <LiveClock timezone={profile.personal.timezone} />
        </div>
      </div>
    </div>

    <!-- Social Links Grid -->
    <div class="mb-5">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
        {t('profile.socials')}
      </div>
      <div class="grid grid-cols-2 gap-2">
        {profile.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between px-3 py-2 rounded-xl border border-neutral-200/60 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-medium text-neutral-700 dark:text-neutral-300 transition-colors group"
          >
            <div class="flex items-center gap-2">
              <SocialIcon name={social.icon} class="w-3.5 h-3.5 text-neutral-500 group-hover:text-indigo-500 transition-colors" />
              <span>{social.name}</span>
            </div>
            <ArrowUpRight class="w-3 h-3 text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        ))}
      </div>
    </div>

    <!-- Core Tech Stack -->
    <div class="mb-6">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
        {t('profile.techStack')}
      </div>
      <div class="flex flex-wrap gap-1.5">
        {highlightedTech.map((tech) => (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
            <span>{tech.name}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Direct Email CTA -->
    <a
      href="mailto:contact@tschenfeng.com"
      class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-xs"
    >
      <Mail class="w-4 h-4" />
      <span>{t('profile.contactCta')}</span>
    </a>
  </div>
</div>

<script>
  function setupMagneticProfile() {
    const card = document.getElementById('profile-card');
    const backdrop = document.getElementById('profile-backdrop');

    // Portal modal and backdrop to document.body to ensure top-level stacking above all containers
    if (card && backdrop && card.parentElement !== document.body) {
      document.body.appendChild(backdrop);
      document.body.appendChild(card);
    }

    const triggerBtns = document.querySelectorAll<HTMLButtonElement>('.profile-open-btn');
    const closeBtn = document.getElementById('profile-close');

    if (!triggerBtns.length || !card || !closeBtn || !backdrop) return;

    const profileCard = card;
    const profileBackdrop = backdrop;

    let isExpanded = false;

    function openProfile() {
      isExpanded = true;
      triggerBtns.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
      });

      profileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
      profileBackdrop.classList.add('opacity-100', 'pointer-events-auto');

      profileCard.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
      profileCard.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
    }

    function closeProfile() {
      isExpanded = false;
      triggerBtns.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
      });

      profileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
      profileBackdrop.classList.add('opacity-0', 'pointer-events-none');

      profileCard.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
      profileCard.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
    }

    triggerBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        openProfile();
      });
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeProfile();
    });

    backdrop.addEventListener('click', () => {
      closeProfile();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isExpanded) {
        closeProfile();
      }
    });
  }

  setupMagneticProfile();
  document.addEventListener('astro:after-swap', setupMagneticProfile);
</script>
