---
import { profileConfig } from '@/config/profile';
import LiveClock from '@/components/ui/LiveClock.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { MapPin, X, ChevronRight, Mail, ArrowUpRight } from '@lucide/astro';

const highlightedTech = profileConfig.techStack.filter((t) => t.highlight);
---

<!-- Magnetic Profile Dock Wrapper -->
<div id="magnetic-profile-root" class="relative">
  <!-- 1. Collapsed Magnetic Image Trigger (Floating Left on Desktop, Thumb-friendly Bottom on Mobile) -->
  <button
    id="profile-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="profile-card"
    aria-label={`查看个人资料 - ${profileConfig.personal.name}`}
    title={`查看个人资料 - ${profileConfig.personal.name}`}
    class="fixed bottom-5 left-4 sm:left-6 lg:bottom-auto lg:top-24 lg:left-8 xl:left-12 z-30 group relative p-1 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-lg hover:shadow-2xl hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300 hover:scale-110 cursor-pointer"
  >
    <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-xl overflow-hidden shadow-xs">
      <img
        src={profileConfig.personal.avatarUrl}
        alt={profileConfig.personal.name}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="eager"
      />
    </div>
    <!-- Active Status Pulse Dot -->
    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900 shadow-xs flex items-center justify-center">
      <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-neutral-900 animate-pulse-subtle"></span>
    </span>
  </button>

  <!-- 2. Overlay Backdrop for Click-Outside (Mobile & Desktop) -->
  <div
    id="profile-backdrop"
    class="fixed inset-0 bg-neutral-950/40 dark:bg-black/60 backdrop-blur-xs z-40 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- 3. Expanded Profile Card Panel -->
  <div
    id="profile-card"
    class="fixed bottom-4 left-4 right-4 sm:right-auto sm:w-[380px] max-h-[88vh] overflow-y-auto rounded-3xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-2xl p-6 pb-8 lg:bottom-auto lg:top-24 lg:left-8 xl:left-12 z-50 opacity-0 pointer-events-none -translate-x-4 scale-95 transition-all duration-300 ease-out"
  >
    <!-- Header: Status & Close Button -->
    <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-neutral-800/80 mb-5">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
        <span>{profileConfig.personal.statusText}</span>
      </div>

      <button
        id="profile-close"
        type="button"
        aria-label="关闭个人资料卡片"
        class="w-7 h-7 rounded-full flex items-center justify-center text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Avatar & Identity -->
    <div class="flex items-center gap-4 mb-4">
      <div class="relative shrink-0">
        <div class="w-16 h-16 rounded-2xl overflow-hidden border border-neutral-200 dark:border-neutral-700 shadow-sm">
          <img
            src={profileConfig.personal.avatarUrl}
            alt={profileConfig.personal.name}
            class="w-full h-full object-cover"
          />
        </div>
        <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900"></span>
      </div>

      <div>
        <div class="flex items-baseline gap-2 mb-0.5">
          <h2 class="text-xl font-bold text-neutral-900 dark:text-white">
            {profileConfig.personal.name}
          </h2>
          {profileConfig.personal.nativeName && (
            <span class="text-xs text-neutral-400 dark:text-neutral-500">
              ({profileConfig.personal.nativeName})
            </span>
          )}
        </div>
        <p class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
          {profileConfig.personal.title}
        </p>
      </div>
    </div>

    <!-- Bio Statement -->
    <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4">
      {profileConfig.personal.shortBio}
    </p>

    <!-- Location & Live Clock -->
    <div class="p-3.5 rounded-2xl bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200/60 dark:border-neutral-700/60 mb-5">
      <div class="flex items-center justify-between text-xs mb-2">
        <div class="flex items-center gap-1.5 text-neutral-600 dark:text-neutral-400 font-medium">
          <MapPin class="w-3.5 h-3.5 text-indigo-500" />
          <span>{profileConfig.personal.location}</span>
        </div>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">Asia/Shanghai</span>
      </div>
      <div class="flex items-center justify-between text-xs">
        <span class="text-neutral-400 dark:text-neutral-500">本地时间</span>
        <div class="font-mono font-semibold text-neutral-800 dark:text-neutral-200">
          <LiveClock timezone={profileConfig.personal.timezone} />
        </div>
      </div>
    </div>

    <!-- Social Links Grid -->
    <div class="mb-5">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
        社交与主页
      </div>
      <div class="grid grid-cols-2 gap-2">
        {profileConfig.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between px-3 py-2 rounded-xl border border-neutral-200/60 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-medium text-neutral-700 dark:text-neutral-300 transition-colors group"
          >
            <div class="flex items-center gap-2">
              <SocialIcon name={social.icon} class="w-3.5 h-3.5 text-neutral-500 group-hover:text-indigo-500 transition-colors" />
              <span>{social.name}</span>
            </div>
            <ArrowUpRight class="w-3 h-3 text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        ))}
      </div>
    </div>

    <!-- Core Tech Stack -->
    <div class="mb-6">
      <div class="text-[11px] font-medium uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
        核心技术栈
      </div>
      <div class="flex flex-wrap gap-1.5">
        {highlightedTech.map((tech) => (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
            <span>{tech.name}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Direct Email CTA -->
    <a
      href="mailto:contact@tschenfeng.com"
      class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-xs"
    >
      <Mail class="w-4 h-4" />
      <span>邮件联系探讨合作</span>
    </a>
  </div>
</div>

<script>
  function setupMagneticProfile() {
    const trigger = document.getElementById('profile-trigger');
    const card = document.getElementById('profile-card');
    const closeBtn = document.getElementById('profile-close');
    const backdrop = document.getElementById('profile-backdrop');

    if (!trigger || !card || !closeBtn || !backdrop) return;

    let isExpanded = false;

    function openProfile() {
      isExpanded = true;
      trigger.setAttribute('aria-expanded', 'true');
      trigger.classList.add('opacity-0', 'pointer-events-none', 'invisible');

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');

      card.classList.remove('opacity-0', 'pointer-events-none', '-translate-x-4', 'scale-95');
      card.classList.add('opacity-100', 'pointer-events-auto', 'translate-x-0', 'scale-100');
    }

    function closeProfile() {
      isExpanded = false;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('opacity-0', 'pointer-events-none', 'invisible');

      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      card.classList.remove('opacity-100', 'pointer-events-auto', 'translate-x-0', 'scale-100');
      card.classList.add('opacity-0', 'pointer-events-none', '-translate-x-4', 'scale-95');
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      openProfile();
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeProfile();
    });

    backdrop.addEventListener('click', () => {
      closeProfile();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isExpanded) {
        closeProfile();
      }
    });
  }

  setupMagneticProfile();
  document.addEventListener('astro:after-swap', setupMagneticProfile);
</script>
