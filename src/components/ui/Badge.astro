---
export interface Props {
  variant?: 'default' | 'outline' | 'success' | 'accent' | 'highlight';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  class: className = '',
} = Astro.props;

const variantClasses = {
  default: 'bg-neutral-100 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200 border-neutral-200 dark:border-neutral-700',
  outline: 'bg-transparent text-neutral-700 dark:text-neutral-300 border-neutral-300 dark:border-neutral-700',
  success: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border-emerald-200/80 dark:border-emerald-800/60',
  accent: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300 border-indigo-200/80 dark:border-indigo-800/60',
  highlight: 'bg-amber-50 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300 border-amber-200/80 dark:border-amber-800/60',
};

const sizeClasses = {
  sm: 'text-xs px-2 py-0.5',
  md: 'text-xs font-medium px-2.5 py-1',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border transition-colors select-none',
    variantClasses[variant],
    sizeClasses[size],
    className,
  ]}
>
  <slot />
</span>
