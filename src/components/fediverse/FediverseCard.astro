---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { Radio, Copy, Check, ArrowUpRight, AtSign } from '@lucide/astro';

interface Props {
  lang?: Lang;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const liveHandle = '@tschenfeng.com@web.brid.gy';
const mastodonProfileUrl = 'https://mastodon.social/@tschenfeng.com@web.brid.gy';
---

<div class="fediverse-card p-4 rounded-2xl border border-indigo-200/70 dark:border-indigo-900/60 bg-gradient-to-br from-indigo-50/60 via-white/80 to-purple-50/50 dark:from-indigo-950/30 dark:via-neutral-900/80 dark:to-purple-950/20 backdrop-blur-md shadow-xs mb-5">
  <!-- Header: Protocol Badge & Pulse -->
  <div class="flex items-center justify-between gap-2 mb-2.5">
    <div class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-indigo-600 dark:text-indigo-400">
      <Radio class="w-3.5 h-3.5 text-indigo-500 animate-pulse-subtle" />
      <span>{t('fediverse.badge')}</span>
    </div>

    <span class="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-600 dark:text-emerald-400">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
      <span>{t('fediverse.status')}</span>
    </span>
  </div>

  <!-- Handle Display -->
  <div class="p-2.5 rounded-xl bg-white/90 dark:bg-neutral-950/70 border border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between gap-2 mb-3">
    <div class="flex items-center gap-1.5 min-w-0">
      <AtSign class="w-3.5 h-3.5 text-indigo-500 shrink-0" />
      <span class="font-mono text-xs font-semibold text-neutral-800 dark:text-neutral-200 truncate select-all">
        {liveHandle}
      </span>
    </div>

    <button
      type="button"
      class="fediverse-copy-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 text-[11px] font-medium transition-all cursor-pointer shrink-0"
      data-handle={liveHandle}
      data-copied={t('fediverse.copied')}
      data-copy={t('fediverse.copy')}
      title={t('fediverse.copy')}
    >
      <Copy class="w-3 h-3 copy-icon" />
      <Check class="w-3 h-3 check-icon text-emerald-500 hidden" />
      <span class="copy-label">{t('fediverse.copy')}</span>
    </button>
  </div>

  <!-- Direct Link to Mastodon Profile -->
  <a
    href={mastodonProfileUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white text-xs font-semibold transition-all shadow-xs group cursor-pointer mb-2"
  >
    <span>{t('fediverse.openMastodon')}</span>
    <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
  </a>

  <!-- Explanatory Tip -->
  <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed font-normal">
    {t('fediverse.desc')}
  </p>
</div>

<script>
  function setupFediverseCard() {
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.fediverse-copy-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const handle = btn.getAttribute('data-handle');
        if (!handle) return;

        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label');
        const copiedText = btn.getAttribute('data-copied') || 'Copied!';
        const defaultText = btn.getAttribute('data-copy') || 'Copy Handle';

        try {
          await navigator.clipboard.writeText(handle);
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (label) label.textContent = copiedText;

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (label) label.textContent = defaultText;
          }, 2000);
        } catch (err) {
          // Clipboard fallback
        }
      });
    });
  }

  setupFediverseCard();
  document.addEventListener('astro:after-swap', setupFediverseCard);
</script>
