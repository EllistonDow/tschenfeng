---
import { ArrowUpRight, BookOpen, Calendar } from '@lucide/astro';
import { getLangFromUrl, useTranslations, formatDate } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  lang?: Lang;
}

const { slug, title, description, pubDate, tags, lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const postHref = lang === 'zh' ? `/zh/blog/${slug}` : `/blog/${slug}`;
const formattedDate = formatDate(pubDate, lang);
---

<a
  href={postHref}
  class="feed-item group block p-5 sm:p-6 rounded-3xl border border-neutral-200/70 dark:border-neutral-800/70 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-md hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-lg transition-all duration-300"
>
  <div class="flex items-center justify-between gap-3 mb-2.5">
    <span class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wide uppercase px-2.5 py-0.5 rounded-full bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 border border-purple-200/60 dark:border-purple-800/60">
      <BookOpen class="w-3 h-3" />
      <span>{t('feed.writing')}</span>
    </span>

    <div class="flex items-center gap-1 text-xs text-neutral-400 font-mono">
      <Calendar class="w-3.5 h-3.5" />
      <span>{formattedDate}</span>
    </div>
  </div>

  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
      {title}
    </h3>
    <ArrowUpRight class="w-4 h-4 text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-white transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0 mt-1" />
  </div>

  <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
    {description}
  </p>

  <div class="flex flex-wrap items-center gap-1.5 pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
    {tags.map((tag) => (
      <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">
        #{tag}
      </span>
    ))}
  </div>
</a>
