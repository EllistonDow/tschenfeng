---
import { getCollection } from 'astro:content';
import PostFeedItem from './PostFeedItem.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<div class="w-full pb-16">
  <!-- Articles Stream -->
  <div class="space-y-4 sm:space-y-5">
    {sortedPosts.map((post) => (
      <PostFeedItem
        id={post.id}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
      />
    ))}
  </div>

  <!-- Stream End Indicator -->
  <div class="pt-12 pb-6 text-center text-xs text-neutral-400 dark:text-neutral-500 font-mono flex items-center justify-center gap-2">
    <span class="w-8 h-px bg-neutral-200 dark:bg-neutral-800"></span>
    <span>End of Stream · 持续写作与思考中</span>
    <span class="w-8 h-px bg-neutral-200 dark:bg-neutral-800"></span>
  </div>
</div>
