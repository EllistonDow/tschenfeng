---
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { ExternalLink, Layers } from '@lucide/astro';

export interface Props {
  title: string;
  description: string;
  tags: string[];
  metrics?: string;
  link?: string;
  github?: string;
}

const { title, description, tags, metrics, link, github } = Astro.props;
---

<article class="feed-item group relative p-5 sm:p-6 rounded-3xl border border-neutral-200/70 dark:border-neutral-800/70 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-md hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-lg transition-all duration-300">
  <div class="flex items-center justify-between gap-3 mb-2.5">
    <span class="inline-flex items-center gap-1.5 text-[11px] font-medium tracking-wide uppercase px-2.5 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/60">
      <Layers class="w-3 h-3" />
      <span>项目 / Project</span>
    </span>

    <div class="flex items-center gap-2">
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          title="查看源码"
        >
          <SocialIcon name="github" class="w-4 h-4" />
        </a>
      )}
      {link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          title="在线演示"
        >
          <ExternalLink class="w-4 h-4" />
        </a>
      )}
    </div>
  </div>

  <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
    {title}
  </h3>

  <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
    {description}
  </p>

  <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
    <div class="flex flex-wrap items-center gap-1.5">
      {tags.map((tag) => (
        <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">
          {tag}
        </span>
      ))}
    </div>

    {metrics && (
      <span class="text-xs font-mono font-medium text-emerald-600 dark:text-emerald-400">
        {metrics}
      </span>
    )}
  </div>
</article>
