---
import { getProfileConfig } from '@/config/profile';
import { getLangFromUrl } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const profile = getProfileConfig(lang);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": profile.personal.name,
  ...(profile.personal.nativeName ? { "alternateName": profile.personal.nativeName } : {}),
  "jobTitle": profile.personal.title,
  "url": profile.site.url,
  "image": profile.personal.avatarUrl,
  "sameAs": profile.socials.map((s) => s.url).filter((u) => u.startsWith('http')),
  "description": profile.personal.shortBio,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": profile.site.title,
  "url": profile.site.url,
  "description": profile.site.description,
  "inLanguage": lang === 'zh' ? 'zh-CN' : 'en-US',
  "author": {
    "@type": "Person",
    "name": profile.personal.name
  }
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
