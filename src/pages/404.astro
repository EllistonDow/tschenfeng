---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { ArrowLeft, House } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'zh' ? '/zh' : '/';
---

<BaseLayout title={`${t('404.title')} (404) | Austin`} lang={lang}>
  <div class="min-h-[50vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-mono font-bold text-2xl mb-6 border border-indigo-200/80 dark:border-indigo-800/60 shadow-xs">
      404
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white mb-2">
      {t('404.title')}
    </h1>

    <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-md mb-8">
      {t('404.desc')}
    </p>

    <div class="flex items-center gap-3">
      <a
        href={homeHref}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs sm:text-sm font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-xs"
      >
        <House class="w-4 h-4" />
        <span>{t('404.backHome')}</span>
      </a>

      <button
        onclick="history.back()"
        type="button"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/60 text-neutral-700 dark:text-neutral-300 text-xs sm:text-sm font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all cursor-pointer shadow-xs"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>{t('404.backPrev')}</span>
      </button>
    </div>
  </div>
</BaseLayout>
