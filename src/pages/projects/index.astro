---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { getCollection } from 'astro:content';
import { Layers, ExternalLink, ArrowUpRight, Sparkles } from '@lucide/astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout
  title="工程作品 & 开源项目 | Austin"
  description="精选开源工具、分布式系统原型与 AI Agent 应用实践。"
>
  <div class="max-w-5xl mx-auto py-2">
    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">
        <Layers class="w-3.5 h-3.5" />
        <span>Selected Works & Projects</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white mb-2">
        工程作品 & 开源项目
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        聚焦高性能 Web 架构、AI 智能体编排与现代基础设施，坚持代码开源与透明设计。
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((project) => (
        <div class="bento-card p-6 flex flex-col justify-between group">
          <div>
            <div class="flex items-start justify-between gap-3 mb-3">
              <h2 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {project.data.title}
              </h2>

              <div class="flex items-center gap-2 shrink-0">
                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1.5 rounded-lg border border-neutral-200/80 dark:border-neutral-800 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
                    title="查看源码"
                  >
                    <SocialIcon name="github" class="w-4 h-4" />
                  </a>
                )}
                {project.data.link && (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1.5 rounded-lg border border-neutral-200/80 dark:border-neutral-800 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
                    title="访问在线演示"
                  >
                    <ExternalLink class="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>

            <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">
              {project.data.description}
            </p>
          </div>

          <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800/80">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-1.5">
                {project.data.tags.map((tag) => (
                  <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                    {tag}
                  </span>
                ))}
              </div>

              {project.data.metrics && (
                <span class="text-xs font-mono font-medium text-emerald-600 dark:text-emerald-400">
                  {project.data.metrics}
                </span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact CTA Banner -->
    <div class="bento-card p-6 sm:p-8 mt-10 flex flex-col sm:flex-row items-center justify-between gap-6 bg-gradient-to-br from-indigo-50/50 via-white to-purple-50/40 dark:from-indigo-950/20 dark:via-neutral-900 dark:to-purple-950/20">
      <div class="text-center sm:text-left">
        <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white mb-1 flex items-center justify-center sm:justify-start gap-2">
          <Sparkles class="w-4 h-4 text-indigo-500" />
          <span>有合作意向或技术探讨？</span>
        </h3>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
          欢迎关于前端架构、性能调优或独立产品研发的深度交流。
        </p>
      </div>

      <a
        href="mailto:contact@tschenfeng.com"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 text-xs sm:text-sm font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-all shadow-xs shrink-0 group"
      >
        <span>发起邮件联系</span>
        <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    </div>
  </div>
</BaseLayout>
