---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MagneticProfile from '@/components/profile/MagneticProfile.astro';
import StreamFeed from '@/components/stream/StreamFeed.astro';
import { getProfileConfig } from '@/config/profile';

const profile = getProfileConfig('zh');
---

<BaseLayout
  title={profile.site.title}
  description={profile.site.description}
  lang="zh"
>
  <!-- Single Central Stream Feed with Left Docked Trigger -->
  <div class="relative w-full">
    <MagneticProfile lang="zh" />
    <StreamFeed lang="zh" />
  </div>
</BaseLayout>
