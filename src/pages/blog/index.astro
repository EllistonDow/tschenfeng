---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { getCollection } from 'astro:content';
import { Calendar, Tag, ArrowRight, Rss } from '@lucide/astro';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}
---

<BaseLayout
  title="技术文章 & 思考 | Austin"
  description="记录关于前端架构、边缘计算、AI 智能体与现代 Web 性能优化的深度工程实践。"
>
  <div class="w-full py-2">
    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">
          <span>Writing & Engineering Notes</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white mb-2">
          技术文章 & 思考
        </h1>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          记录在软件架构、边缘计算与 AI Agent 系统的实战经验。
        </p>
      </div>

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors shrink-0 shadow-xs"
      >
        <Rss class="w-3.5 h-3.5 text-amber-500" />
        <span>RSS 订阅</span>
      </a>
    </div>

    <!-- Posts List -->
    <div class="space-y-4">
      {posts.map((post) => (
        <article class="bento-card p-6 transition-all group">
          <a href={`/blog/${post.id}`} class="block">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
              <h2 class="text-lg sm:text-xl font-bold text-neutral-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {post.data.title}
              </h2>
              <span class="text-xs text-neutral-400 font-mono shrink-0 flex items-center gap-1.5">
                <Calendar class="w-3.5 h-3.5" />
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </span>
            </div>

            <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">
              {post.data.description}
            </p>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
              <div class="flex flex-wrap items-center gap-1.5">
                {post.data.tags.map((tag) => (
                  <Badge variant="outline" size="sm">
                    <Tag class="w-2.5 h-2.5" />
                    {tag}
                  </Badge>
                ))}
              </div>

              <span class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-0.5 transition-transform">
                <span>阅读全文</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
