---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MagneticProfile from '@/components/profile/MagneticProfile.astro';
import StreamFeed from '@/components/stream/StreamFeed.astro';
import { profileConfig } from '@/config/profile';
---

<BaseLayout
  title={profileConfig.site.title}
  description={profileConfig.site.description}
>
  <!-- Left-Docked Magnetic Collapsible Profile Card -->
  <MagneticProfile />

  <!-- Single Central Stream Feed -->
  <div class="relative w-full">
    <StreamFeed />
  </div>
</BaseLayout>
