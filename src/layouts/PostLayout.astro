---
import BaseLayout from './BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { ArrowLeft, Calendar, Tag } from '@lucide/astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<BaseLayout
  title={`${title} | Austin`}
  description={description}
  article={{ pubDate, tags }}
>
  <article class="w-full py-4">
    <!-- Back Button -->
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors mb-6 group"
    >
      <ArrowLeft class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" />
      <span>返回文章列表</span>
    </a>

    <!-- Article Header -->
    <header class="mb-8 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        {tags.map((tag) => (
          <Badge variant="accent" size="sm">
            <Tag class="w-3 h-3" />
            {tag}
          </Badge>
        ))}
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white mb-3 leading-tight">
        {title}
      </h1>

      <p class="text-base text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">
        {description}
      </p>

      <div class="flex items-center gap-4 text-xs text-neutral-500 dark:text-neutral-400">
        <span class="inline-flex items-center gap-1.5">
          <Calendar class="w-3.5 h-3.5" />
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        </span>
      </div>
    </header>

    <!-- Article Body Content -->
    <div class="prose prose-neutral dark:prose-invert max-w-none text-neutral-800 dark:text-neutral-200 leading-relaxed [&>h2]:text-xl [&>h2]:font-bold [&>h2]:mt-8 [&>h2]:mb-3 [&>h2]:text-neutral-900 dark:[&>h2]:text-white [&>h3]:text-lg [&>h3]:font-semibold [&>h3]:mt-6 [&>h3]:mb-2 [&>p]:mb-4 [&>p]:leading-7 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:mb-4 [&>li]:mb-1.5">
      <slot />
    </div>

    <!-- Article Bottom Share / Back -->
    <div class="mt-12 pt-6 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>返回文章列表</span>
      </a>

      <a
        href="#top"
        class="text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
      >
        回到顶部 ↑
      </a>
    </div>
  </article>
</BaseLayout>
